{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "../dist",
    "rootDir": "..",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@embedra/db": ["../packages/db/index.ts"],
      "@embedra/types": ["../packages/types/index.ts"]
    }
  },
  "include": ["src/**/*"]
}